{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "node_modules",
    "tmp"
  ],
  "include": [
    "src/**/*.ts"
  ]
}