{
  "name": "website-builder-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "start:builder": "nx serve builder-app",
    "start:admin": "nx serve admin-app",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:sprint12-uat": "node --test scripts/sprint12-uat-automation.test.mjs",
    "api:generate": "openapi-generator-cli generate -i docs/api/openapi.yaml -g typescript-angular -o libs/api-client",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "grapesjs": "^0.22.16",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular-eslint/eslint-plugin": "17.5.3",
    "@angular-eslint/eslint-plugin-template": "17.5.3",
    "@angular-eslint/template-parser": "17.5.3",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@nx/angular": "^18.3.0",
    "@nx/eslint": "^18.3.0",
    "@nx/jest": "18.3.5",
    "@nx/js": "18.3.5",
    "@nx/workspace": "^18.3.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jest": "^29.4.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-preset-angular": "14.4.2",
    "nx": "^18.3.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.13",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.1.0",
